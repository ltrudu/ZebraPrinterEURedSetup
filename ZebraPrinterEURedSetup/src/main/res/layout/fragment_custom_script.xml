<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/customScriptRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CustomScriptFragment">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Entry Info Card (for view-only mode) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEntryInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:visibility="gone"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textViewEntryTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/label_description"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textViewEntryDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            tools:text="Calibrate Printer using sensors" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Connectivity Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConnectivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Header -->
                        <LinearLayout
                            android:id="@+id/headerConnectivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="16dp"
                            android:background="?attr/selectableItemBackground">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/titleConnectivity"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:text="@string/title_connectivity"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                        </LinearLayout>

                        <!-- Content -->
                        <LinearLayout
                            android:id="@+id/contentConnectivity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingBottom="16dp">

                            <!-- Connectivity Type Spinner -->
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/labelConnectivityType"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="@string/label_connectivity_type"
                                android:textAppearance="?attr/textAppearanceTitleMedium" />

                            <Spinner
                                android:id="@+id/spinnerConnectivityType"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="16dp"
                                android:background="@drawable/spinner_background"
                                android:padding="12dp" />

                            <!-- BLE Fields Container -->
                            <LinearLayout
                                android:id="@+id/bleFieldsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/labelMacAddress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginBottom="8dp"
                                    android:text="@string/label_printer_mac_address"
                                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/textInputLayoutMacAddress"
                                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:hint="@string/hint_mac_address">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/editTextMacAddress"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:inputType="text"
                                            android:maxLines="1" />

                                    </com.google.android.material.textfield.TextInputLayout>

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/buttonScanBarcode"
                                        style="@style/Widget.Zebra.Button.Icon"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:contentDescription="@string/content_description_scan_barcode"
                                        app:icon="@drawable/ic_barcode" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Custom Script Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCustomScript"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"
                    android:layout_marginTop="8dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/titleCustomScript"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center"
                            android:text="@string/title_custom_script"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutScript"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:hint="@string/hint_custom_script">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextScript"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:inputType="textMultiLine|textNoSuggestions"
                                android:gravity="top|start"
                                android:scrollbars="vertical"
                                android:overScrollMode="always"
                                android:nestedScrollingEnabled="true"
                                android:fontFamily="monospace"
                                android:textSize="12sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <!-- Bottom Row: Show Documentation, Immersive Mode, and Drag Handle -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.checkbox.MaterialCheckBox
                                android:id="@+id/checkBoxShowDocumentation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_show_documentation"
                                android:checked="false" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonToggleImmersive"
                                style="@style/Widget.Zebra.Button.Icon"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:contentDescription="@string/content_description_toggle_immersive"
                                app:icon="@drawable/ic_fullscreen" />

                            <ImageView
                                android:id="@+id/dragHandle"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_marginStart="8dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_drag_handle"
                                android:contentDescription="@string/content_description_drag_resize"
                                android:background="?attr/selectableItemBackgroundBorderless" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Suggestions Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    app:cardElevation="8dp"
                    app:cardCornerRadius="8dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorOutline">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textViewSuggestionsHeader"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:text="@string/label_suggestions"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="?attr/colorPrimary"
                            android:background="?attr/colorSurfaceVariant" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewSuggestions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxHeight="200dp"
                            android:nestedScrollingEnabled="true" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Editor Mode Actions Card (shown when in editor mode) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEditorActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="2dp"
                    app:strokeColor="?attr/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonEditorCancel"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:text="@string/button_cancel" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonEditorSave"
                            style="@style/Widget.Zebra.Button.Tonal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/button_save_changes" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Update Launcher Script Card (shown when editing a custom entry) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUpdateLauncherScript"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorPrimary">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/titleUpdateLauncherScript"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="center"
                            android:text="@string/title_update_launcher_script"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonCancelChanges"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="4dp"
                                android:text="@string/button_cancel"
                                android:textSize="12sp"
                                app:cornerRadius="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonSaveChanges"
                                style="@style/Widget.Zebra.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="4dp"
                                android:text="@string/button_save_changes"
                                android:textSize="12sp"
                                app:cornerRadius="8dp" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/titleStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:gravity="center"
                            android:text="@string/title_status"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/textViewStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/status_ready"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Send Data Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSendData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/titleSendData"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="center"
                            android:text="@string/title_send_data"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonSendScript"
                            style="@style/Widget.Zebra.Button.Tonal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/button_send_script_to_printer" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- File Operations Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardFileOperations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardElevation="4dp"
                    app:cardCornerRadius="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.google.android.material.textview.MaterialTextView
                            android:id="@+id/titleFileOperations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="center"
                            android:text="@string/title_file_operations"
                            android:textAppearance="?attr/textAppearanceTitleMedium" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonImportScript"
                                style="@style/Widget.Zebra.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                android:text="@string/button_import_script" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/buttonExportScript"
                                style="@style/Widget.Zebra.Button.Tonal"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/button_export_script" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <!-- Fragment container for barcode scanner -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
