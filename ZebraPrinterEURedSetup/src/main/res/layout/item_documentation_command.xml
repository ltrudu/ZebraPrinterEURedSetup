<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCommand"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp"
    app:rippleColor="?attr/colorControlHighlight">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (always visible) -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp">

            <!-- Command Type Badge -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textViewTypeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/badge_background"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@android:color/white"
                android:textAllCaps="true"
                tools:text="ZPL" />

            <!-- Command Name -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textViewCommand"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                tools:text="^A" />

            <!-- Expand/Collapse Icon -->
            <ImageView
                android:id="@+id/imageViewExpand"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_expand_more"
                android:contentDescription="@string/content_description_expand_collapse"
                app:tint="?android:textColorSecondary" />

        </LinearLayout>

        <!-- Short Description (always visible) -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/textViewName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:textColorSecondary"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Scalable/Bitmapped Font" />

        <!-- Expanded Content -->
        <LinearLayout
            android:id="@+id/layoutExpandedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider"
                android:layout_marginBottom="12dp" />

            <!-- Format Section -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/labelFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_format"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textViewFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:background="@drawable/code_background"
                android:padding="8dp"
                tools:text="^Afo,h,w" />

            <!-- Description Section -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/labelDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_description"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textViewDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="The ^A command specifies the font to use in a text field." />

            <!-- Parameters Section (ZPL) -->
            <LinearLayout
                android:id="@+id/layoutParameters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/labelParameters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_parameters"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textViewParameters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:fontFamily="monospace"
                    android:background="@drawable/code_background"
                    android:padding="8dp"
                    tools:text="f = font name\no = orientation\nh = height\nw = width" />

            </LinearLayout>

            <!-- Returns Section (ZBI) -->
            <LinearLayout
                android:id="@+id/layoutReturns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/labelReturns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_returns"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textViewReturns"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="N/A" />

            </LinearLayout>

            <!-- Supported Actions Section (SGD) -->
            <LinearLayout
                android:id="@+id/layoutActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/labelActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_supported_actions"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textViewActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="setvar, getvar, do" />

            </LinearLayout>

            <!-- Possible Values Section (SGD) -->
            <LinearLayout
                android:id="@+id/layoutValues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/labelValues"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_possible_values"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textViewValues"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:fontFamily="monospace"
                    android:background="@drawable/code_background"
                    android:padding="8dp"
                    tools:text="on, off" />

            </LinearLayout>

            <!-- Default Value Section (SGD) -->
            <LinearLayout
                android:id="@+id/layoutDefault"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/labelDefault"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_default_value"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/textViewDefault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:fontFamily="monospace"
                    tools:text="NA" />

            </LinearLayout>

            <!-- Page Reference -->
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/textViewPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:textColorTertiary"
                tools:text="Page 60" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
