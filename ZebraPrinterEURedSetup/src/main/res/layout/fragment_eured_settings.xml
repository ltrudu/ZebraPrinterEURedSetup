<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".EURedSettingsFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Change Password Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChangePassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with title and checkbox -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_change_password"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxChangePasswordEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_enable"
                        android:checked="true" />

                </LinearLayout>

                <!-- Content - Old and New Password fields -->
                <LinearLayout
                    android:id="@+id/contentChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Old Secure Password -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/labelOldPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_old_password"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutOldPassword"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextOldPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonClearOldPassword"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_clear_old_password"
                            app:icon="@drawable/ic_close" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonScanOldPassword"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_scan_old_password"
                            app:icon="@drawable/ic_barcode" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:paddingStart="16dp"
                        android:text="@string/helper_old_password"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <!-- New Secure Password -->
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/labelNewPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_new_password"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutNewPassword"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextNewPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPrefillNewPassword"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_use_default_password"
                            app:icon="@drawable/ic_close" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonScanNewPassword"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_scan_new_password"
                            app:icon="@drawable/ic_barcode" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:text="@string/helper_new_password"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Authentication Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAuthentication"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/title_authentication"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/textInputLayoutAuthPassword"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextAuthPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonClearAuthPassword"
                        style="@style/Widget.Zebra.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/content_description_clear_auth_password"
                        app:icon="@drawable/ic_close" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonScanAuthPassword"
                        style="@style/Widget.Zebra.Button.Icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@string/content_description_scan_auth_password"
                        app:icon="@drawable/ic_barcode" />

                </LinearLayout>

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:text="@string/helper_auth_password"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Protected Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProtectedMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/title_protected_mode"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxProtectedModeAllowed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_protected_mode_allowed"
                    android:checked="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- EURed Configuration Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEuredConfiguration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/title_eured_configuration"
                    android:textAppearance="?attr/textAppearanceTitleMedium" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxFirmwareDownload"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_firmware_download"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxTcpEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_tcp_enable"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxLpdEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_lpd_enable"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxHttpsEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_https_enable"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxFtpEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_ftp_enable"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxSnmpEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_snmp_enable"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxWlanEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_wlan_enable"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxUsbMirrorEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_usb_mirror_enable"
                    android:checked="false" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/checkboxZbiEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_zbi_enable"
                    android:checked="false" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Set HTTP Admin Password Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHttpAdminPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with title and checkbox -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_http_admin_password"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxHttpAdminEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_enabled"
                        android:checked="false" />

                </LinearLayout>

                <!-- Content - HTTP Admin Password field -->
                <LinearLayout
                    android:id="@+id/contentHttpAdminPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/labelHttpAdminPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_http_admin_password"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutHttpAdminPassword"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextHttpAdminPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonPrefillHttpAdminPassword"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_use_default_password"
                            app:icon="@drawable/ic_close" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonScanHttpAdminPassword"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_scan_http_admin_password"
                            app:icon="@drawable/ic_barcode" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:text="@string/helper_http_admin_password"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Display Password Current Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDisplayPasswordCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with title and checkbox -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_display_password_current"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxDisplayPasswordCurrentEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_enabled"
                        android:checked="false" />

                </LinearLayout>

                <!-- Content - Password Current field -->
                <LinearLayout
                    android:id="@+id/contentDisplayPasswordCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutPasswordCurrent"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:endIconMode="password_toggle">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextPasswordCurrent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:maxLines="1" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonClearPasswordCurrent"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_clear_password_current"
                            app:icon="@drawable/ic_close" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonScanPasswordCurrent"
                            style="@style/Widget.Zebra.Button.Icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/content_description_scan_password_current"
                            app:icon="@drawable/ic_barcode" />

                    </LinearLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="16dp"
                        android:text="@string/helper_password_current"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Device Prompted Network Reset Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDevicePromptedNetworkReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with title and checkbox -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_device_prompted_network_reset"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxDevicePromptedNetworkResetEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_enabled"
                        android:checked="false" />

                </LinearLayout>

                <!-- Content - Dropdown -->
                <LinearLayout
                    android:id="@+id/contentDevicePromptedNetworkReset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spinnerDevicePromptedNetworkReset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Bluetooth Discoverable Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBluetoothDiscoverable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header with title and checkbox -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/title_bluetooth_discoverable"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxBluetoothDiscoverableEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_enabled"
                        android:checked="false" />

                </LinearLayout>

                <!-- Content - Is Discoverable dropdown -->
                <LinearLayout
                    android:id="@+id/contentBluetoothDiscoverable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_is_discoverable"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <Spinner
                        android:id="@+id/spinnerBluetoothDiscoverable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Setvar Wlan Enable Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSetvarWlanEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
