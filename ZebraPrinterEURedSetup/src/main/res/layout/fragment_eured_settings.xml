                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/checkboxSetvarWlanEnableEnabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/label_enabled"
                        android:checked="false" />

                </LinearLayout>

                <!-- Content - WLan enabled dropdown -->
                <LinearLayout
                    android:id="@+id/contentSetvarWlanEnable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/label_wlan_enabled"
                        android:textAppearance="?attr/textAppearanceBodyMedium" />

                    <Spinner
                        android:id="@+id/spinnerSetvarWlanEnable"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_background"
                        android:padding="12dp" />

                </LinearLayout>

            </LinearLayout>

